{
  "version": 2,
  "env": {
    "BROWSERSLIST_IGNORE_OLD_DATA": "true"
  },
  "builds": [
    {
      "src": "subPetro-backend/api/**/*.js",
      "use": "@vercel/node"
    },
    {
      "src": "package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "build"
      }
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/subPetro-backend/api/$1.js"
    },
    {
      "src": "/((?!static/)(?!.*\\.).*)",
      "dest": "/index.html"
    }
  ]
}
